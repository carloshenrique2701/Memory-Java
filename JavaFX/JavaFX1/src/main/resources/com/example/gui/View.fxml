<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="300.0" prefWidth="400.0" style="-fx-background-color: #000;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gui.ViewController">
   <children>
      <ComboBox fx:id="comboBoxPerson" layoutX="50.0" layoutY="44.0" onAction="#onComboBoxPersonAction" prefWidth="150.0" promptText="Select a person..." />
      <Button fx:id="btAll" layoutX="250.0" layoutY="44.0" mnemonicParsing="false" onAction="#onBtAllAction" stylesheets="@../../../templates/estilos.css" text="All" />
   </children>
</AnchorPane>
